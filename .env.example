# ── Ma'lumotlar bazasi ──
POSTGRES_USER=anc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anc
DATABASE_URL=postgresql://anc:change-me@localhost:5432/anc?schema=public

# ── API ──
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Har biri uchun: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_VERIFICATION_SECRET=
OTP_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
EXAM_GRACE_SEC=30

# ── AI ──
AI_ENGINE_URL=http://localhost:8000
AI_INTERNAL_KEY=
AI_DAILY_LIMIT_FREE=20
# mock | anthropic | openai_compatible
# Claude uchun: LLM_PROVIDER=anthropic va LLM_API_KEY=sk-ant-... (https://console.anthropic.com)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=

# ── Seed ──
SEED_ADMIN_PHONE=+998900000000
SEED_ADMIN_PASSWORD=ChangeMe123!

# ── Ops ──
OTP_DEV_ECHO=false          # true: dev'da OTP kod javobda qaytadi (production'da e'tiborsiz)
METRICS_TOKEN=               # /api/v1/metrics uchun Bearer token (bo'sh = ochiq, faqat ichki tarmoqda)
BACKUP_PASSPHRASE=           # backup shifrlash kaliti — xavfsiz joyda saqlang
